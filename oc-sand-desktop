#!/usr/bin/env bash
# Desktop starter for the sandbox container: brings up Xvfb on display :99,
# two x11vnc listeners on that display (view-only :5900 for the host user,
# password-protected full-control :5901) and the XFCE desktop session.
# Runs as the "opencode" user; entrypoint.sh calls it when OC_SAND_DESKTOP=1
# and it is safe to call repeatedly.
set -euo pipefail

LOG_DIR=/tmp/oc-sand-desktop

# Already up: a running Xvfb :99 means the whole stack was started before.
if pgrep -f '^Xvfb :99' >/dev/null; then
  exit 0
fi

mkdir -p "$LOG_DIR"

# Software-rendered X server for the desktop; -nolisten tcp keeps it on the
# container-local unix socket only.
Xvfb :99 -screen 0 "${OC_SAND_DESKTOP_GEOMETRY:-1600x900x24}" -nolisten tcp &

# Bounded (<= 10s) wait for the X socket so the VNC servers and the desktop
# never start against a display that is not ready yet.
for _ in {1..50}; do
  if [ -S /tmp/.X11-unix/X99 ]; then
    break
  fi
  sleep 0.2
done
if [ ! -S /tmp/.X11-unix/X99 ]; then
  echo "error: Xvfb :99 did not create /tmp/.X11-unix/X99 within 10 seconds" >&2
  exit 1
fi

# One-shot password setup: the listeners below read the file instead, so the
# password appears in an argv only for this brief call. rfbauth truncates
# the password to 8 characters (documented in README.adoc).
# Prevent a brief world-readable window on the passwd file between
# -storepasswd and the chmod below.
umask 077
mkdir -p /home/opencode/.vnc
x11vnc -storepasswd "${OC_SAND_VNC_PASSWORD:-sandvnc1}" /home/opencode/.vnc/passwd
chmod 600 /home/opencode/.vnc/passwd

# Allowed-hosts list for the VNC listeners (SEC-001 remediation): the
# default accept list is in-container loopback plus the docker bridge
# gateway IP — the source address host-originated connections arrive with
# — so sibling containers on the shared network are refused. A non-empty
# OC_SAND_VNC_ALLOW overrides this verbatim and deliberately suspends the
# fail-closed behavior below (commas separate hosts for x11vnc).
ALLOW_HOSTS=
if [ -n "${OC_SAND_VNC_ALLOW:-}" ]; then
  ALLOW_HOSTS=$OC_SAND_VNC_ALLOW
else
  default_route=$(ip -4 route show default 2>/dev/null | head -n 1 || true)
  gateway=$(printf '%s\n' "$default_route" | awk '{for (i = 2; i < NF; i++) if ($i == "via") { print $(i + 1); exit } }')
  if [ -n "$gateway" ] && [[ $gateway =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    ALLOW_HOSTS="127.0.0.1,$gateway"
  else
    error="error: docker bridge gateway IP not determinable (default route: '$default_route'); skipping BOTH x11vnc listeners (fail-closed) — set OC_SAND_VNC_ALLOW for exotic setups"
    echo "$error" >&2
    echo "$error" >>"$LOG_DIR/gateway-detection.log"
  fi
fi

# Listeners start only when an allowed-hosts value was established; the
# desktop below still starts when detection failed.
if [ -n "$ALLOW_HOSTS" ]; then
  # View listener (container :5900, published on the host as 127.0.0.1:15901):
  # watches the desktop, accepts no input.
  x11vnc -display :99 -rfbport 5900 -rfbauth /home/opencode/.vnc/passwd -allow "$ALLOW_HOSTS" -viewonly -shared -forever -bg -o "$LOG_DIR/x11vnc-view.log"

  # Control listener (container :5901, published on the host as 127.0.0.1:15902):
  # full input, same password file — the deliberate escalation channel, for
  # trusted parties only.
  x11vnc -display :99 -rfbport 5901 -rfbauth /home/opencode/.vnc/passwd -allow "$ALLOW_HOSTS" -shared -forever -bg -o "$LOG_DIR/x11vnc-control.log"
fi

# The desktop itself, under its own dbus session; lives for the container
# lifetime. DISPLAY is set explicitly here so the script also works when run
# from a shell that did not inherit the image ENV (e.g. manual runs).
DISPLAY=:99 dbus-run-session -- startxfce4 >>"$LOG_DIR/xfce4.log" 2>&1 &
